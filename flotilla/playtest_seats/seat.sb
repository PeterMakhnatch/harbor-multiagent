(version 1)
(allow default)

(deny file-read-data
  (subpath (param "HOSTHOME"))
  (subpath "/private/tmp")
  (subpath (param "HOSTTMP")))
(allow file-read* file-read-data
  (subpath (param "SEATROOT"))
  (subpath (param "SEATSCRIPTS"))
  (subpath (string-append (param "HOSTHOME") "/.local/bin"))
  (subpath (string-append (param "HOSTHOME") "/.local/share/claude"))
  (subpath (string-append (param "HOSTHOME") "/.local/state/claude"))
  (subpath (string-append (param "HOSTHOME") "/.claude"))
  (prefix (string-append (param "HOSTHOME") "/.claude.json"))
  (literal (string-append (param "HOSTHOME") "/.codex/auth.json")))
(deny file-read* file-read-data
  (subpath (string-append (param "HOSTHOME") "/.claude/projects"))
  (literal (string-append (param "HOSTHOME") "/.claude/history.jsonl")))

(deny file-write*)
(allow file-write*
  (subpath (param "SEATROOT"))
  (subpath (string-append (param "HOSTHOME") "/.claude"))
  (subpath (string-append (param "HOSTHOME") "/.local/state/claude"))
  (prefix (string-append (param "HOSTHOME") "/.claude.json"))
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/tty")
  (regex #"^/dev/ttys[0-9]+$")
  (regex #"^/dev/fd/")
  (literal "/dev/dtracehelper"))
(deny file-write*
  (subpath (string-append (param "HOSTHOME") "/.claude/projects"))
  (literal (string-append (param "HOSTHOME") "/.claude/history.jsonl")))

(deny network-outbound)
(allow network-outbound
  (remote ip "localhost:*")
  (remote tcp "*:443")
  (remote udp "*:53")
  (remote unix-socket))
