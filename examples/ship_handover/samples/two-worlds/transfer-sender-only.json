  "notes": {
    "comparison": "larger when the whole transfer interval is > 0, smaller when it is < 0, equal when it is exactly [0/1,0/1], unresolved otherwise",
    "delta": "deliver success interval minus withhold success interval, sharp bounds",
    "eligible": "only reported rows with status positive or zero (world grade 1 or 0, grade source native_agreed) count as known outcomes: both native seats returned with no error and the grade was verified",
    "fractions": "every bound is an exact reduced fraction written numerator/denominator",
    "physical": "physical_known and physical_positive count unresolved or native_error rows that still carry a world grade; they are reported per world and never enter a success interval",
    "pooling": "no success rate is pooled across states, channels or worlds; world totals are accounting counts only",
    "reported": "reported counts packet rows received for registered cells; receipt of a row is not a witnessed seat return",
    "scope": "registrations and packets are stationary operator inputs read once; digests name content only and are not credentials, signatures or proof of a model response; the report describes the registered team under the registered worlds only, with no causal or model attribution, p-value or cost claim",
    "states": "original_succeeds pairs stock committed with inflight settles; original_fails pairs stock dropped with inflight fails",
    "success": "[k/n,(k+u)/n] over the registered n of one world, state and channel, with k positive and u unknown; an exact identification bound, not a sampling confidence interval",
    "transfer": "inflight delta minus stock delta within one original state, sharp bounds",
    "unknown": "every other registered cell is unknown, never a failure: missing cells (no reported row, no_result) and every declared other status; the status duplicate is a declared collection status, distinct from a repeated ticket claim across packets, which is rejected"
  },
