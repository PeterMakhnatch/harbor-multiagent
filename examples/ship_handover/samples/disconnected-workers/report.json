  "notes": {
    "disagreeing": "unissued_eligible counts tickets whose ledger says unissued while a received row carries an eligible grade; the records disagree and the grade is kept in every transfer interval, never discarded",
    "eligible": "eligible counts received packet rows with status positive or zero (world grade 1 or 0, grade source native_agreed); receipt of a packet row is not a witnessed seat return",
    "issued": "issued counts tickets whose ledger row records one grant; a grant permits one attempted native start and does not prove that the native process or any seat started; a lost grant spends the ticket and never authorizes a restart; unissued is not proof that no other launcher ran",
    "physical": "physical counts unresolved or native_error rows that still carry a world grade; they are reported by admission state and never enter an interval",
    "scope": "aggregate counts only; no ticket, path, roster, hidden state or native identifier is reported; digests name content only and are not credentials, signatures or proof of a model response",
    "transfer": "deltas and transfer intervals come from examples.ship_handover.transfer over every received packet regardless of admission state; admission never changes a grade, a count or a bound",
    "unknown": "unknown counts tickets with no received row or a declared non-graded status; unknown is never zero and never a failure"
  },
